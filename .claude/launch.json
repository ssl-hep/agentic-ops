{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-dev",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "backend",
        "run",
        "uvicorn",
        "app.main:app",
        "--port",
        "8001"
      ],
      "env": {
        "SCRATCH_DIR": "scratch"
      },
      "port": 8001
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "3001"
      ],
      "env": {
        "BACKEND_URL": "http://localhost:8001"
      },
      "port": 3001
    }
  ]
}
