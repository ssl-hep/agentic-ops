# Copy to the repo root as .env (gitignored). Variable names only; never commit values.

# MLflow tracking server. Basic-auth credentials can be embedded (https://user:pass@host)
# or given separately as MLFLOW_TRACKING_USERNAME / MLFLOW_TRACKING_PASSWORD.
MLFLOW_TRACKING_URI=

# OpenAI-compatible LLM endpoint (NCSA Lumen)
LLM_BASE_URL=https://lumen.ncsa.illinois.edu/v1
LLM_API_KEY=
LLM_MODEL=deepseek

# Bearer token for the AF MCP gateway, referenced from mcp.json as ${MCP_BEARER_TOKEN}
MCP_BEARER_TOKEN=

# AF username used in the prompt (defaults to your login name)
# AF_USER=
