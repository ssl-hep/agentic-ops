# Question 1: an AF job unpacks the worker environment and completes a no-op activity over
# mTLS through the public endpoint. Start the workflow first (shim.start_noop), then:
#
#   condor_submit noop.sub ADDRESS=<host>:443 SERVER_NAME=<host> DIGEST=<sha256 of the tarball>
#
# Against the phase 1 server: ADDRESS=temporal.ndslabs.org:31644 SERVER_NAME=temporal.ndslabs.org
# NAMESPACE=ewkit-production (the worker environment must include the shim that reads it).
#
# CERTS is a worker certificate directory for production phase0, signed by the worker CA
# (`agentic-ops-pki worker --production phase0`, or clients/ewkit-phase0 from `dev`), in a 0700
# directory you own. Phase 0 sends it by file transfer; the plan's design hands it over with
# HTCondor's credential handling instead.
#
# condor_submit reads NAME=value arguments before this file, so a plain assignment here would
# override them: the defaults are set only when the name is not already defined.
if ! defined TARBALL
  TARBALL = /data/$ENV(USER)/agentic-ops/builds/phase0/worker-env.tar.gz
endif
if ! defined CERTS
  CERTS = $ENV(HOME)/phase0-certs/ewkit-phase0
endif
if ! defined QUEUE_NAME
  QUEUE_NAME = ewkit-phase0-default
endif
if ! defined NAMESPACE
  NAMESPACE = phase0
endif

universe = vanilla
executable = bootstrap.sh
arguments = "$(TARBALL) $(DIGEST) shim.noop_worker --address $(ADDRESS) --server-name $(SERVER_NAME) --certs ewkit-phase0 --queue $(QUEUE_NAME) --idle-timeout 3600"
environment = "PHASE0_NAMESPACE=$(NAMESPACE)"
transfer_input_files = $(CERTS)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
request_cpus = 1
request_memory = 2GB
request_disk = 2GB
output = logs/noop.$(Cluster).$(Process).out
error = logs/noop.$(Cluster).$(Process).err
log = logs/noop.$(Cluster).log
queue
